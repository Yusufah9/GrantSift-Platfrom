# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_SYNTHESIS=gemini-1.5-pro

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Google OAuth (configured inside Supabase Auth providers, listed here for reference)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Transactional email (pick one provider; EmailService reads whichever is set)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="GrantSift <hello@grantsift.app>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
